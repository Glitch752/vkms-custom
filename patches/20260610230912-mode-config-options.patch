+static struct config_group *make_mode_group(struct config_group *group,
+                        const char *name)
+{
+    struct vkms_configfs_connector *connector;
+    struct vkms_configfs_device *dev;
+    struct vkms_configfs_mode *mode;
+    int ret;
+
+    /* The group passed here is the "modes" default group */
+    connector = connector_modes_item_to_vkms_configfs_connector(&group->cg_item);
+    dev = connector->dev;
+
+    scoped_guard(mutex, &dev->lock) {
+        if (dev->enabled)
+            return ERR_PTR(-EBUSY);
+
+        mode = kzalloc(sizeof(*mode), GFP_KERNEL);
+        if (!mode)
+            return ERR_PTR(-ENOMEM);
+
+        mode->dev = dev;
+
+        /* Allocate the underlying mode config and attach it to the connector */
+        mode->config = vkms_config_create_mode(connector->config);
+        if (IS_ERR(mode->config)) {
+            ret = PTR_ERR(mode->config);
+            kfree(mode);
+            return ERR_PTR(ret);
+        }
+
+        config_group_init_type_name(&mode->group, name, &mode_item_type);
+    }
+
+    return &mode->group;
